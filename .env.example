# Copia este archivo a .env (gitignored) y pon los valores reales.
# Solo aplica al perfil "dev" (application-dev.yml). qa/docker/prod ya reciben
# estas variables desde el entorno (k8s / GitHub Actions), no desde un .env.

SPRING_DATASOURCE_URL=jdbc:mysql://HOST:3306/NOMBRE_BD
SPRING_DATASOURCE_USERNAME=usuario
SPRING_DATASOURCE_PASSWORD=password
