# Plantilla para correr el proyecto LOCAL (debug) apuntando a los datos reales de QA.
#
# Cómo usarla:
#   1. Copia este archivo como ".env" en la raíz del proyecto:  cp .env.example .env
#   2. Rellena los valores marcados como REQUERIDO (el proyecto no arranca sin ellos).
#   3. ".env" está en .gitignore -- nunca se sube, es seguro poner ahí los valores reales.
#
# Con SPRING_PROFILES_ACTIVE=qa,local-qa, application-local-qa.yml carga este archivo
# automáticamente al arrancar (spring.config.import) -- no hace falta ningún plugin de IDE
# para inyectar las variables, solo que el .env exista en la raíz del proyecto.

# ── Perfil ───────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=qa,local-qa
SERVER_PORT=9010

# ── Base de datos (QA, alcanzable directo desde fuera del clúster) ─────────
DB_HOST=51.178.29.99
SPRING_DB_NAME=inventario_key_qa
SPRING_DATASOURCE_USERNAME=user_ventas_qa
SPRING_DATASOURCE_PASSWORD=
# ↑ REQUERIDO. Sacarlo con: kubectl exec -it <pod> -n qa -- env | grep SPRING_DATASOURCE_PASSWORD

# ── Redis / RabbitMQ: LOCALES (Docker), no los de QA ────────────────────────
# docker run -d --name redis-local -p 6379:6379 redis:7-alpine
# docker run -d --name rabbitmq-local -p 5672:5672 -p 15672:15672 \
#   -e RABBITMQ_DEFAULT_USER=admin -e RABBITMQ_DEFAULT_PASS=admin rabbitmq:3-management
SPRING_RABBITMQ_USERNAME=admin
SPRING_RABBITMQ_PASSWORD=admin

# ── Micro de imágenes (QA, para no levantarlo local) ────────────────────────
ENDPOINT_IMAGENES=https://qa.backend-imagenes.novedades-jade.com.mx/mis-productos/

# ── Correo (QA real -- cualquier correo que mandes al debuggear es real) ────
MAIL_USERNAME=qa.boutique.bolsas@novedades-jade.com.mx
MAIL_PASSWORD=
# ↑ Sin esto el proyecto arranca igual, pero no se pueden mandar correos.
#   Sacarlo con: kubectl exec -it <pod> -n qa -- env | grep MAIL_PASSWORD
CHAT_ADMIN_EMAIL=

# ── JWT ──────────────────────────────────────────────────────────────────────
TOKEN_JWT=
# ↑ REQUERIDO. Sacarlo con: kubectl exec -it <pod> -n qa -- env | grep TOKEN_JWT

# ── Mercado Pago (sandbox) ───────────────────────────────────────────────────
ACCESS_TOKE_MERCADO_PAGO=
# ↑ REQUERIDO. Sacarlo con: kubectl exec -it <pod> -n qa -- env | grep ACCESS_TOKE_MERCADO_PAGO
DEVICE_ID=
# ↑ REQUERIDO. Sacarlo con: kubectl exec -it <pod> -n qa -- env | grep DEVICE_ID

# ── OpenAI (REQUERIDO -- ChatbotService lo necesita para arrancar, aunque no pruebes el chat) ──
OPENAI_API_KEY=
# ↑ REQUERIDO. Sacarlo con: kubectl exec -it <pod> -n qa -- env | grep OPENAI_API_KEY

# ── Facebook / Instagram (opcional -- solo si vas a probar esas integraciones) ──────────────
FACEBOOK_PAGE_ID=645820348605806
INSTAGRAM_ACCOUNT_ID=17841444237033427
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

# ── TikTok (opcional) ─────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Reconciliación (opcional) ──────────────────────────────────────────────────
RECONCILIACION_ADMIN_USERNAME=admin
RECONCILIACION_ADMIN_PASSWORD=

# ── WhatsApp (opcional) ────────────────────────────────────────────────────────
WHATSAPP_PROVEEDOR=callmebot
WHATSAPP_APIKEY=
WHATSAPP_COUNTRY_CODE=52
